<div class="filament-card @MaterialClass">

    <div class="card-header">

        <div class="header-left">

            <div class="material-badge">
                @Material
            </div>

            <span class="filament-code">
                @Codigo
            </span>

        </div>

        <div class="status @StatusClass">

            <i class="bi bi-circle-fill"></i>

            @Status

        </div>

    </div>

    <div class="card-body">

        <div class="preview @MaterialClass">

            <i class="bi bi-circle-fill"></i>

        </div>

        <div class="info">

            <h3>@Nome</h3>

            <span class="brand">
                @Marca
            </span>

            <span class="color-name">
                @Cor
            </span>

        </div>

    </div>

    <div class="stock-header">

        <span>ESTOQUE</span>

        <strong>@PesoAtualFormatado / @PesoOriginalFormatado</strong>

    </div>

    <div class="progress">

        <div class="progress-fill"
             style="width:@($"{Percentual}%")">
        </div>

    </div>

    <div class="details">

        <div class="item">

            <span>VALOR COMPRA</span>

            <strong>@ValorCompraFormatado</strong>

        </div>

        <div class="item">

            <span>CUSTO / g</span>

            <strong class="orange">
                @ValorGramaFormatado
            </strong>

        </div>

        <div class="item">

            <span>FORNECEDOR</span>

            <strong>
                @Fornecedor
            </strong>

        </div>

        <div class="item">

            <span>ENTRADA</span>

            <strong>
                @DataEntradaFormatada
            </strong>

        </div>

    </div>

    <div class="card-footer">

        <div>

            <small>DISPONÍVEL</small>

            <strong>@Percentual%</strong>

        </div>

        <button class="details-button"
                @onclick="VisualizarDetalhes">

            <i class="bi bi-eye"></i>

            Visualizar

        </button>

        <button class="details-button" @onclick="EditarFilamento">
            <i class="bi bi-pencil"></i>
            Editar
        </button>

    </div>

</div>