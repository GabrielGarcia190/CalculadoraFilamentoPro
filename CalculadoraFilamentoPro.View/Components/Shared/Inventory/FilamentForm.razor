<Modal
    Visible="@Visible"
    Title="@(ModoEdicao ? "Editar Filamento" : "Cadastrar Novo Filamento")"
    Subtitle="Insira os dados do carretel, especificações térmicas e custos de aquisição"
    Icon="@(ModoEdicao ? "bi bi-pencil-square" : "bi bi-plus-circle")"
    Badge="@(ModoEdicao ? "Edição" : "Novo Cadastro")"
    Code="@(ModoEdicao ? $"#FIL-{FilamentParaEditar!.Id.ToString()[..8].ToUpperInvariant()}" : "#FIL-001")"
    Status="@(ModoEdicao ? "Registro Existente" : "Entrada no Rack")"
    OnClose="Close">

    <div class="filament-form">
        <FormSection Number="1" Title="Identificação do Material" Description="">
            <div class="form-grid form-grid-identification">
                <div class="form-field">
                    <label for="filament-name">Nome do Filamento / Cor *</label>
                    <input id="filament-name" @bind="Nome" placeholder="PLA Silk Ouro Real" />
                </div>

                <div class="form-field">
                    <label for="polymer-type">Tipo de Polímero *</label>
                    <select id="polymer-type" @bind="TipoSelecionado">
                        <option value="PLA">PLA (Polylactic Acid)</option>
                        <option value="PETG">PETG</option>
                        <option value="ABS">ABS</option>
                        <option value="ASA">ASA</option>
                        <option value="TPU">TPU</option>
                        <option value="Nylon">Nylon</option>
                        <option value="CarbonFiber">Carbon Fiber</option>
                    </select>
                </div>

                <div class="form-field">
                    <label for="filament-brand">Marca / Fabricante *</label>
                    <input id="filament-brand" @bind="Marca" placeholder="Sunlu Silk Series" />
                </div>

                <div class="form-field color-field">
                    <label for="filament-color-code">Amostra Cromática &amp; Hex</label>
                    <div class="color-input">
                        <input class="color-picker" type="color" @bind="CorHex" aria-label="Selecionar cor" />
                        <input id="filament-color-code" @bind="Cor" />
                    </div>
                </div>
            </div>
        </FormSection>

        <FormSection Number="2" Title="Peso &amp; Custos de Aquisição" Description="">
            <div class="form-grid form-grid-costs">
                <div class="form-field">
                    <label for="net-weight">Peso Líquido (g) *</label>
                    <input id="net-weight" type="number" @bind="Peso" />
                </div>

                <div class="form-field">
                    <label for="paid-price">Preço Pago (R$) *</label>
                    <input id="paid-price" type="number" step="0.01" @bind="Preco" />
                </div>

                <div class="form-field">
                    <label for="shipping-price">Frete Rateado (R$)</label>
                    <input id="shipping-price" type="number" step="0.01" @bind="Frete" />
                </div>
            </div>

            <div class="cost-summary">
                <span class="cost-label"><i class="bi bi-calculator"></i> Custo real por grama:</span>
                <strong>@CustoPorGrama <small>/ grama</small></strong>
            </div>
        </FormSection>

        @if (!string.IsNullOrWhiteSpace(Erro))
        {
            <div class="form-error">@Erro</div>
        }

        <div class="form-actions">
            <button class="form-cancel" type="button" @onclick="Close">Cancelar</button>
            <button class="form-save" type="button" @onclick="Salvar">
                <i class="bi bi-check-circle"></i>
                @(ModoEdicao ? "Salvar Alterações" : "Salvar Filamento no Estoque")
            </button>
        </div>
    </div>
</Modal>