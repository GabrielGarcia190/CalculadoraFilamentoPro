@page "/setup/database"
@using CalculadoraFilamentoPro.Domain.Configurations.Enums

<div class="setup-page">

    <main class="setup-content">

        <div class="setup-card">

            <SetupHeader />

            <div class="setup-body">

                <section class="database-card">

                    <div class="database-title">

                        <h2>
                            <i class="bi bi-database-fill"></i>
                            Conectar Banco de Dados
                        </h2>

                        <p>
                            Selecione o provedor e insira sua string de conexão para inicializar o sistema antes do acesso operacional.
                        </p>

                    </div>


                    <div class="providers-header">

                        <span>PROVEDOR DE DADOS</span>

                        <span>DRIVER: NATIVO</span>

                    </div>


                    <div class="providers-grid">

                        <DatabaseProviderCard 
                            Icon="bi bi-hdd-network"
                            Title="PostgreSQL"
                            Subtitle="Recomendado"
                            Selected="@(SelectedProvider == EDatabaseProvider.PostgreSql)"
                            OnClick="() => SelectProvider(EDatabaseProvider.PostgreSql)" />


                        <DatabaseProviderCard 
                            Icon="bi bi-device-hdd"
                            Title="SQLite"
                            Subtitle=".db Local"
                            Selected="@(SelectedProvider == EDatabaseProvider.SQLite)"
                            OnClick="() => SelectProvider(EDatabaseProvider.SQLite)" />

                    </div>

                </section>


                <div class="connection-header">

                    <span>
                        STRING DE CONEXÃO (CONNECTION STRING URI)
                    </span>

                </div>


                <ConnectionStringInput 
                    @bind-Value="ConnectionString" />

                    
                <div class="connection-help">

                    <i class="bi bi-info-circle"></i>

                    <div>

                        Exemplo:

                        @if(SelectedProvider == EDatabaseProvider.PostgreSql)
                        {
                            <strong>
                                Host=localhost;Port=5432;Database=app;Username=user;Password=senha
                            </strong>
                        }
                        else
                        {
                            <strong>
                                Data Source=dados.db
                            </strong>
                        }

                    </div>

                </div>

                <div class="setup-actions">

                    <button class="btn-escuro"
                            @onclick="Cancel">

                        Cancelar

                    </button>


      <button class="btn-laranja"
        @onclick="ConfirmAsync">
    Confirmar
</button>

                </div>




            </div>

        </div>

    </main>

</div>