<div class="provider-card @(Selected ? "selected" : "")">

    <i class="@Icon icon"></i>

    <h3>@Title</h3>

    <span>@Subtitle</span>

</div>

@code {

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string Subtitle { get; set; } = "";

    [Parameter]
    public string Icon { get; set; } = "";

    [Parameter]
    public bool Selected { get; set; }

}