<section class="card-resultado">

    <div class="resultado-topo">
        <span class="titulo">VALOR SUGERIDO AO CLIENTE</span>

        <span class="badge-pronta">
            <i class="bi bi-gear"></i>
            Cotação Pronta
        </span>
    </div>

    <div class="valor-total">
        <span class="cifrao">R$</span>
        <span class="valor">@Total.ToString("N2")</span>
    </div>

    <p class="descricao">
        Custo total calculado com serviço incluso
    </p>

    <div class="separador"></div>

    <div class="linha">
        <span>
            <i class="ponto laranja"></i>
            Custo de Material (Filamento)
        </span>

        <strong>@CustoMaterial.ToString("C2")</strong>
    </div>

    <div class="linha">
        <span>
            <i class="ponto ciano"></i>
            Custo de Energia
        </span>

        <strong>@CustoEnergia.ToString("C2")</strong>
    </div>

    <div class="linha">
        <span>
            <i class="ponto salmao"></i>
            Desgaste da Máquina
        </span>

        <strong>@Desgaste.ToString("C2")</strong>
    </div>

    <div class="linha">
        <span>
            <i class="ponto verde"></i>
            Valor do Serviço
        </span>

        <strong class="verde">@MaoDeObra.ToString("C2")</strong>
    </div>

    <button class="btn-principal" @onclick="OnCopiar">
        <i class="bi bi-chat-left-text"></i>

        @(Copiado ? "Copiado!" : "Copiar Orçamento (WhatsApp)")
    </button>

    <button class="btn-exportar">
        <i class="bi bi-file-earmark-pdf"></i>
        Exportar PDF / Relatório
    </button>

    <a href="#" class="relatorio">
        Ver Relatório Técnico Detalhado →
    </a>

</section>

@code {
    [Parameter] public double Total { get; set; }
    [Parameter] public double CustoMaterial { get; set; }
    [Parameter] public double CustoEnergia { get; set; }
    [Parameter] public double Desgaste { get; set; }
    [Parameter] public double MaoDeObra { get; set; }
    [Parameter] public bool Copiado { get; set; }
    [Parameter] public EventCallback OnCopiar { get; set; }
}