@page "/register"

<div class="login-page">

    <div class="login-card">

        <div class="logo">
            <i class="bi bi-box-seam-fill"></i>
        </div>

        <h1>Print3D Calcs Pro</h1>

        <p class="subtitle">
            Crie o primeiro usuário da aplicação.
        </p>

        <div class="form-group">

            <label>Nome</label>

            <input
                @bind="Name"
                placeholder="Digite seu nome" />

        </div>

        <div class="form-group">

            <label>Senha</label>

            <input
                type="password"
                @bind="Password"
                placeholder="Digite sua senha" />

        </div>

        <button class="btn-login"
                @onclick="CreateUser">

            <i class="bi bi-person-plus-fill"></i>

            Criar Conta

        </button>

        <button class="btn-link"
                @onclick="Back">

            <i class="bi bi-arrow-left"></i>

            Voltar ao Login

        </button>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="error">
                @Error
            </div>
        }

    </div>

</div>