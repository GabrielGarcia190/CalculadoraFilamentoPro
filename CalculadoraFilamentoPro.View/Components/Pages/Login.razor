@page "/login"

<ToastNotification @ref="Toast" />

<div class="login-page">

    <div class="login-container">

        <div class="logo-box">
            <div class="logo">
                <i class="bi bi-box"></i>
            </div>

            <h1>
                Print3D
                <span>Calcs Pro</span>
            </h1>

            <div class="subtitle">
                <span class="status-dot"></span>
                ACESSO AO SISTEMA
            </div>
        </div>

        <section class="login-card">

            <div class="field">

                <label>NOME DE USUÁRIO</label>

                <div class="input-box">

                    <i class="bi bi-person"></i>

                    <input type="text"
                           @bind="UserName"
                           placeholder="Digite seu nome de usuário" />

                </div>

            </div>

            <div class="field">

                <label>SENHA</label>

                <div class="input-box">

                    <i class="bi bi-lock"></i>

                    <input type="@(MostrarSenha ? "text" : "password")"
                           @bind="Senha"
                           placeholder="••••••••••••" />

                    <button class="show-password"
                            @onclick="ShowPassword"
                            type="button">

                        <i class="bi @(MostrarSenha ? "bi-eye-slash" : "bi-eye")"></i>

                    </button>

                </div>

            </div>

            <div class="login-options">

                <label class="remember">

                    <input type="checkbox"
                           @bind="LembrarUsuario" />

                    <span>Lembrar de mim</span>

                </label>

                <button class="forgot-password"
                @onclick="SignUp"
                        type="button">

                  Cadastrar-se

                </button>

            </div>

            <button class="login-button"
                    @onclick="SignIn">

                Entrar no Sistema

                <i class="bi bi-arrow-right"></i>

            </button>

        </section>

        <div class="footer-text">
            CALCULADORA INDUSTRIAL DE MANUFATURA ADITIVA • v2.4
        </div>

    </div>

</div>