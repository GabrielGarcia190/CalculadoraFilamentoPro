@page "/inventory"
@layout MainLayout

<InventoryHeader OnNewFilament="NovoFilamento" />

<div class="summary-grid">

    <SummaryCard
        Title="Patrimônio em Filamentos"
        Value="R$ 1.840,50"
        Description="18 carretéis catalogados"
        FooterLeft="Investimento"
        FooterRight="100%"
        ShowProgress="true"
        Progress="100"
        ProgressColor="#ff6b00"
        Icon="bi bi-wallet2" />

    <SummaryCard
        Title="Consumo em Produção"
        Value="9,60 kg"
        Description="R$ 1.185,20 faturado"
        FooterLeft="Amortização"
        FooterRight="62,3%"
        ShowProgress="true"
        Progress="62"
        ProgressColor="#81E6FF"
        Icon="bi bi-activity" />

</div>

<AlertBanner
    QuantidadeCritica="2"
    Descricao="O carretel TPU Flex 95A (#FIL-2025-018) possui apenas 140g restantes e o PLA Silk Ouro (#FIL-2025-019) possui 180g. Risco de interrupção em prints longos." />

<InventoryFilters
    Categorias="@Categorias"
    CategoriaSelecionada="@Categoria"
    CategoriaSelecionadaChanged="OnCategoriaChanged" />

<div class="filaments-grid">
    @foreach (var filament in Filamentos)
    {
        <FilamentCard Id="@filament.Id"
                      Codigo="@($"FIL-{filament.Id.ToString()[..8].ToUpperInvariant()}")"
                      Material="@filament.Type.ToString()"
                      MaterialClass="@filament.Type.ToString().ToLowerInvariant()"
                      Status="@(filament.Status.ToString())"
                      StatusClass="ok"
                      Nome="@filament.Name"
                      Marca="@filament.Brand"
                      Cor="@filament.Color"
                      PesoAtual="@filament.RemainingWeight"
                      PesoOriginal="@filament.OriginalWeight"
                      ValorCompra="@filament.CostPrice"
                      ValorGrama="@(filament.OriginalWeight > 0 ? filament.CostPrice / filament.OriginalWeight : 0)"
                      Fornecedor="@filament.Brand"
                      DataEntrada="@filament.PurchaseDate"
                      OnVisualizar="VisualizarFilamento"
                      OnEditar="EditarFilamento" />
    }
</div>

<FilamentForm Visible="@MostrarModal"
             UserId="@UserId"
             FilamentParaEditar="@FilamentoSelecionado"
             OnClose="FecharModal"
             OnSave="SalvarFilamento" />

<Pagination
    CurrentPage="@Pagina"
    TotalPages="5"
    CurrentPageChanged="OnPageChanged" />