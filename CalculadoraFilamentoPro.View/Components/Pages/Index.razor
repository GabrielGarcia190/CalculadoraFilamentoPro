@page "/"
@using CalculadoraFilamentoPro.App.Interfaces.Configurations
@inject IConfigurationService Config
@inject NavigationManager Navigation

@code {
    protected override async Task OnInitializedAsync()
    {
        var destination = await Config.DatabaseConfiguredAsync()
            ? "/login"
            : "/setup/database";

        Navigation.NavigateTo(destination, replace: true);
    }
}
